# Obrigatório: chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Opcional: modelo do Claude (padrão: claude-opus-5-5)
# ZAIRO_MODEL=claude-opus-5-5

# Como o Zairo te chama
ZAIRO_USER_NAME=Marcos
# Cidade padrão para o clima
ZAIRO_CITY=São Paulo

# Voz (TTS): browser (local, padrão) | piper (local, melhor qualidade) | elevenlabs (nuvem)
ZAIRO_TTS=browser

# Piper: caminho do executável e do modelo de voz pt-BR (.onnx)
# PIPER_PATH=/usr/local/bin/piper
# PIPER_MODEL=./voices/pt_BR-faber-medium.onnx

# ElevenLabs (só se ZAIRO_TTS=elevenlabs)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Porta do servidor
PORT=8787
